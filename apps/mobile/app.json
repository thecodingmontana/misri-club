{
  "expo": {
    "name": "Misri",
    "slug": "misri",
    "scheme": "misri",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf8e6"
    },
    "android": {
      "package": "misri.thecodingmontana.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fbf8e6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "misri.thecodingmontana.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-release-signing",
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2b7350",
          "defaultChannel": "news"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextGame",
              "label": "Your next game",
              "description": "Your opponent and the time left to play",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Standing",
              "label": "My standing",
              "description": "Your place and points in a competition",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Streak",
              "label": "Training streak",
              "description": "Your streak and the last four weeks",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "DailyPuzzle",
              "label": "Daily puzzle",
              "description": "Today's Lichess puzzle, a tap away",
              "minWidth": "180dp",
              "minHeight": "200dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://misri-chess-club.vercel.app",
      "apiUrl": "https://misri-api.vercel.app",
      "googleWebClientId": "185581041057-f5jppnvcg109baao402ghnsg92tp29eh.apps.googleusercontent.com"
    }
  }
}
