{
  "expo": {
    "name": "Misri",
    "slug": "misri",
    "scheme": "misri",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf8e6"
    },
    "android": {
      "package": "club.misri.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fbf8e6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "club.misri.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-release-signing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://misri-chess-club.vercel.app",
      "apiUrl": "https://misri-api.vercel.app"
    }
  }
}
