{
  "name": "@misri/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --platform=node --target=node24 --format=esm --outfile=index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "check": "biome check",
    "dev": "node --watch --experimental-strip-types src/dev.ts",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://test:test@127.0.0.1:1/test} node --test --experimental-strip-types 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@misri/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
