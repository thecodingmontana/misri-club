# Copy to .env.local for local development. Production values live in Vercel.

# Postgres: the app uses Supabase's transaction pooler (6543), migrations the session pooler (5432).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Better Auth. Secret: `openssl rand -base64 32` (its own, not Zadaci's). URL: this site's address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005

# Comma-separated emails of club admins (verified accounts only).
ADMIN_EMAILS=

# "Continue with Google" (hidden when empty). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in emails. Without a key, links are printed in the terminal instead (development only).
RESEND_API_KEY=
EMAIL_FROM="Misri Club <noreply@thegoodslab.tech>"

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/deadlines
CRON_SECRET=

# chess.com
CHESSCOM_CLUB_ID=misri
CHESSCOM_USER_AGENT=

# Public site address, used for canonical links and share images (build time).
VITE_SITE_URL=
