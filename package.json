{
  "name": "misri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @misri/web dev",
    "build": "pnpm --filter @misri/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm -r --if-present check",
    "db:generate": "pnpm --filter @misri/web db:generate",
    "db:migrate": "pnpm --filter @misri/web db:migrate"
  }
}
