{
  "name": "misri-club",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3005",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then drizzle-kit migrate; fi && vite build",
    "preview": "vite preview --port 3005",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/stockfish',{recursive:true});for(const ext of ['js','wasm'])fs.copyFileSync('node_modules/stockfish/bin/stockfish-19-lite-single.'+ext,'public/stockfish/stockfish-19-lite-single.'+ext)\"",
    "auth:set-password": "node scripts/set-admin-password.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-devtools": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.1",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "0.2.6",
    "drizzle-orm": "^0.45.4",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stockfish": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/solar": "^1.2.13",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.43",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
